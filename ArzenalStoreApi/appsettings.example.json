{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "StoreConnection": "Server=database;Port=3306;Database=arzenal_store_db;User Id=arzenal_api;Password=configure-with-user-secrets-or-environment;",
    "AuthConnection": "Server=database;Port=3306;Database=arzenal_auth_db;User Id=arzenal_api;Password=configure-with-user-secrets-or-environment;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "AllowedOrigins": [
    "https://store.example.com"
  ],
  "CookieDomain": "store.example.com",
  "Frontend": {
    "PublicBaseUrl": "https://store.example.com/"
  },
  "Storage": {
    "AppFilesPath": "/var/lib/arzenal/apps",
    "MaxUploadBytes": 268435456,
    "RequireMalwareScan": true
  },
  "MalwareScan": {
    "Enabled": true,
    "Host": "clamav",
    "Port": 3310
  },
  "Jwt": {
    "Issuer": "arzenal-api",
    "ExpiryHours": 1,
    "SecretKey": "configure-with-user-secrets-or-environment"
  },
  "Jwt-App-Login": {
    "Issuer": "arzenal-api",
    "SecretKey": "configure-with-user-secrets-or-environment"
  },
  "RefreshToken": {
    "HashKey": "configure-a-base64-encoded-32-byte-key-with-user-secrets-or-environment"
  },
  "AppLogin": {
    "AllowedAppIds": [
      "ArzenalStoreManager"
    ]
  },
  "ReverseProxy": {
    "KnownProxies": []
  }
}
