[*.cs]

# RMG012: Source member was not found for target member
dotnet_diagnostic.RMG012.severity = none

[**/Migrations/**/*.cs]
# Les migrations EF sont générées et l'initialiseur de tableau fait partie de leur snapshot immuable.
dotnet_diagnostic.CA1861.severity = none

[**/Mapping/**/*.cs]
# Ces mappers sont volontairement instanciés et fournis par DI/Mapperly via leurs wrappers.
dotnet_diagnostic.CA1822.severity = none
