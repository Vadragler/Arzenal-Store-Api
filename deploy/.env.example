# Copier ce fichier en .env puis remplacer toutes les valeurs entre chevrons.
# Ne jamais versionner deploy/.env.
ARZENAL_API_IMAGE=arzenal-store-api:1.0.0
MYSQL_APP_PASSWORD=<mot-de-passe-long-et-aleatoire>
MYSQL_ROOT_PASSWORD=<mot-de-passe-root-long-et-aleatoire>
JWT_ISSUER=arzenal-api
JWT_SECRET=<au-moins-32-caracteres-aleatoires>
APP_LOGIN_JWT_ISSUER=arzenal-api
APP_LOGIN_JWT_SECRET=<au-moins-32-caracteres-aleatoires>
REFRESH_TOKEN_HASH_KEY=<cle-base64-de-32-octets>
APP_LOGIN_ALLOWED_ID=ArzenalStoreManager
FRONTEND_ORIGIN=https://store.example.com
COOKIE_DOMAIN=store.example.com
FRONTEND_PUBLIC_BASE_URL=https://store.example.com/
# Adresse IP privée du reverse proxy Docker ; pas son IP publique.
REVERSE_PROXY_IP=172.20.0.10
